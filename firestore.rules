rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin (using email token)
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'estherandmays@gmail.com';
    }

    // Users collection - CRITICAL for signup to work
    match /users/{userId} {
      // Allow anyone authenticated to create their own user document during signup
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can read and update their own data
      allow read, update: if request.auth != null && request.auth.uid == userId;

      // Admins can read/write all users
      allow read, write: if isAdmin();
    }

    // Subcontractors collection (legacy - keeping for compatibility)
    match /subcontractors/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contracts/Projects collection
    match /contracts/{contractId} {
      // Anyone authenticated can read contracts
      allow read: if request.auth != null;

      // Only admins can create/update/delete contracts
      allow write: if isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      // Admins can do everything
      allow read, write: if isAdmin();

      // Subcontractors can read their own payments
      allow read: if request.auth != null &&
                    resource.data.vendorId == request.auth.uid;
    }

    // Messages collection
    match /messages/{messageId} {
      // Admins can do everything
      allow read, write: if isAdmin();

      // Users can read their own messages
      allow read: if request.auth != null &&
                    (resource.data.recipientId == request.auth.uid ||
                     resource.data.senderId == request.auth.uid);
    }

    // Automation rules collection
    match /automation-rules/{ruleId} {
      // Only admins can manage automation rules
      allow read, write: if isAdmin();
    }

    // Admin wildcard rule (fallback for admin access to everything)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
